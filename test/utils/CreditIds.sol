pragma solidity ^0.8.28;

/// credit ids held by the CreditStrategy at fork block 26158000, packed as uint32. test data only.
/// test/Config.t.sol `test_creditIdsAreHeldByTheStrategy` checks every id against the fork
library CreditIds {
    bytes private constant DATA =
        hex"";

    /// the i th id.
    function at(uint256 i) internal pure returns (uint256 id) {
        bytes memory d = DATA;
        require(i * 4 + 4 <= d.length, "ids");
        assembly {
            id := shr(224, mload(add(add(d, 32), mul(i, 4))))
        }
    }
}
