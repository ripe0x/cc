# HyperSync API token: https://envio.dev/app/api-tokens
ENVIO_API_TOKEN="<YOUR-API-TOKEN>"
# Archive RPC for the contract reads (comma-separated for fallbacks, tried in order). Defaults to the public
# endpoints in src/lib/rpc.ts when unset. A dedicated archive node is faster.
# ENVIO_RPC_URL=https://your-archive-rpc
# Requests in flight at once against the RPC (default 6).
# ENVIO_RPC_CONCURRENCY=6
# Optional: stop at a fixed block (used for pinned benchmark and parity runs).
# ENVIO_END_BLOCK=
